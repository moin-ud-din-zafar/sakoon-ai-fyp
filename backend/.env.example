# --- Database (MySQL — default) ---
USE_SQLITE=false
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your_password
DATABASE_NAME=sakoon

# One-time schema: from repo root run:
#   python backend/scripts/setup_mysql.py
# Or: mysql -u root -p < database/init_sakoon.sql

# Optional: file DB instead of MySQL
# USE_SQLITE=true

# OpenRouter API (LLM)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct

# Admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=sakoon123
ADMIN_KEY=sakoon-admin-secret-change-in-prod

# ── Hugging Face ──────────────────────────────────────────────────────────────
HF_TOKEN=
HF_CHAT_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ── Talking Avatar Pipeline ───────────────────────────────────────────────────
# Step 1: XTTS-v2 TTS (set to true to enable — downloads ~1.9 GB on first run)
# Requires: pip install TTS soundfile pydub  +  ffmpeg in PATH
USE_XTTS=false

# Optional: path to a short reference WAV for XTTS voice cloning
# XTTS_REFERENCE_WAV=

# Step 2: Wav2Lip (lip-sync video generation)
# Setup: run  python backend/scripts/setup_wav2lip.py  first
# WAV2LIP_DIR=E:/Ai Virtual Assistant/wav2lip
# WAV2LIP_CHECKPOINT=E:/Ai Virtual Assistant/wav2lip/checkpoints/wav2lip_gan.pth
# WAV2LIP_PYTHON=python

# Face image used for animation (must be a clear frontal face photo)
# AVATAR_FACE_IMAGE=E:/Ai Virtual Assistant/frontend/public/avatars/face.jpg

# Wav2Lip output tuning (optional)
# WAV2LIP_RESIZE=1
# WAV2LIP_PAD_TOP=0
# WAV2LIP_PAD_BOTTOM=10
